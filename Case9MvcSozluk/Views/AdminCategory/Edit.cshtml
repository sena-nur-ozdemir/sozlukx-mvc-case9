@model Case9MvcSozluk.Models.CategoryFormViewModel
@{
    ViewBag.Title = "Kategori Düzenle";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
<div class="sz-head"><div><div class="sz-eyebrow">KATEGORİLER / DÜZENLE</div><h1>Kategori düzenle</h1><p>#@Model.CategoryID numaralı kategorinin bilgilerini güncelle.</p></div><a class="sz-btn" href="@Url.Action("Index")"><i class="bi bi-arrow-left"></i> Listeye dön</a></div>
<section class="sz-panel sz-form-card">
    @using (Html.BeginForm("Edit", "AdminCategory", FormMethod.Post))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(m => m.CategoryID)
        <div class="sz-validation">@Html.ValidationSummary(true, "")</div>
        <div class="sz-form-grid">
            <div class="sz-form-group">
                @Html.LabelFor(m => m.CategoryName)
            @Html.TextBoxFor(m => m.CategoryName, new { @class = "sz-input", maxlength = "50", autocomplete = "off" })
            @Html.ValidationMessageFor(m => m.CategoryName, "", new { @class = "sz-validation" })
        </div>
        <div class="sz-form-group">
            @Html.LabelFor(m => m.CategoryDescription)
        @Html.TextAreaFor(m => m.CategoryDescription, new { @class = "sz-input", rows = "5", maxlength = "250" })
        @Html.ValidationMessageFor(m => m.CategoryDescription, "", new { @class = "sz-validation" })
    </div>
</div>
<div class="sz-form-actions"><button class="sz-btn sz-btn-primary" type="submit"><i class="bi bi-check-lg"></i> Değişiklikleri kaydet</button><a class="sz-btn" href="@Url.Action("Index")">Vazgeç</a></div>
}
</section>
