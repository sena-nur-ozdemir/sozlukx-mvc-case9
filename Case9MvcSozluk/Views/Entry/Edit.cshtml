@model Case9MvcSozluk.Models.EntryEditViewModel
@{ViewBag.Title = "Entry Düzenle"; Layout = "~/Views/Shared/_PublicLayout.cshtml";}
<h1>Entry düzenle</h1><div class="sx-box">
    @using (Html.BeginForm())
    {@Html.AntiForgeryToken() @Html.HiddenFor(x => x.ContentID)
    @Html.ValidationSummary(true, "", new { @class = "sx-error" })
    @Html.LabelFor(x => x.ContentValue) @Html.TextAreaFor(x => x.ContentValue, new { @class = "sx-control", maxlength = 5000 }) @Html.ValidationMessageFor(x => x.ContentValue, "", new { @class = "sx-error" })
    <div class="sx-actions"><button type="submit" class="sx-primary">Değişiklikleri kaydet</button><a href="@Url.Action("Index","Home")" class="sx-secondary">Vazgeç</a></div>}
</div>