@model Case9MvcSozluk.Models.MessageFormViewModel
@{ViewBag.Title = "Mesaj Yaz"; Layout = "~/Views/Shared/_PublicLayout.cshtml";}
<h1>Yeni mesaj</h1><p>Bir SözlükX yazarının kayıtlı e-posta adresine mesaj gönderebilirsin.</p>
<div class="sx-box">
    @using (Html.BeginForm())
    {@Html.AntiForgeryToken() @Html.ValidationSummary(true, "", new { @class = "sx-error" })
    @Html.LabelFor(x => x.Recipient) @Html.TextBoxFor(x => x.Recipient, new { @class = "sx-control", type = "email" }) @Html.ValidationMessageFor(x => x.Recipient, "", new { @class = "sx-error" })
    @Html.LabelFor(x => x.Subject) @Html.TextBoxFor(x => x.Subject, new { @class = "sx-control" }) @Html.ValidationMessageFor(x => x.Subject, "", new { @class = "sx-error" })
    @Html.LabelFor(x => x.Body) @Html.TextAreaFor(x => x.Body, new { @class = "sx-control" }) @Html.ValidationMessageFor(x => x.Body, "", new { @class = "sx-error" })
    <div class="sx-actions"><button type="submit" name="operation" value="send" class="sx-primary">Gönder</button><button type="submit" name="operation" value="draft" class="sx-secondary">Taslak kaydet</button></div>}
</div>