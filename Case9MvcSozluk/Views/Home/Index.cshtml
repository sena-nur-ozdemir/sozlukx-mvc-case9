@model Case9MvcSozluk.Models.HomeIndexViewModel
@using System
@using System.Linq
@{
    Layout = null;
    ViewBag.Title = "SözlükX";
    var selected = Model.SelectedHeadingID;
}
<!DOCTYPE html>
<html lang="tr" data-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>SözlükX — Modern Türk Sözlüğü</title>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@700&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link href="@Url.Content("~/Content/sozlukx-site.css")" rel="stylesheet" />
    <style>
        .topic-item {
            width: calc(100% - 16px);
            border: 0;
            background: transparent;
            font: inherit;
            text-align: left
        }

            .topic-item.active {
                background: var(--accent-soft)
            }

        .sx-entry-tools {
            display: flex;
            gap: 7px;
            align-items: center;
            flex-wrap: wrap
        }

            .sx-entry-tools a, .sx-entry-tools button {
                border: 1px solid var(--border);
                border-radius: 30px;
                padding: 5px 9px;
                background: var(--surface);
                color: var(--text-secondary);
                font-size: 12px;
                text-decoration: none;
                cursor: pointer
            }

                .sx-entry-tools a:hover, .sx-entry-tools button:hover {
                    color: var(--accent)
                }

        .szx-notice {
            background: var(--accent-soft);
            padding: 11px 15px;
            border-radius: 10px;
            color: var(--accent);
            margin-bottom: 17px
        }

            .szx-notice.error {
                background: #fff0ef;
                color: #b33328
            }

        .sx-public-links {
            display: flex;
            align-items: center;
            gap: 8px;
            flex-wrap: wrap
        }

            .sx-public-links a {
                text-decoration: none
            }

                .sx-public-links a:hover {
                    text-decoration: underline
                }

        .sx-headcount {
            font-size: 12px;
            color: var(--text-muted)
        }
    </style>
</head>
<body>
    <nav id="navbar">
        <button class="hamburger" id="hamburgerBtn" aria-label="Menüyü aç"><i class="bi bi-list"></i></button>
        <a class="brand" href="@Url.Action("Index","Home")">Sözlük<span>X</span></a>
        <div class="nav-search-wrap ms-3"><i class="bi bi-search"></i><input id="globalSearch" type="search" placeholder="Başlık ara…" autocomplete="off" /></div>
        <div class="nav-actions">
            <button class="theme-toggle" id="themeToggle" aria-label="Temayı değiştir"><i class="bi bi-moon-stars-fill" id="themeIcon"></i></button>
            @if (Model.CurrentWriterID.HasValue)
            {
                <a class="btn-ghost" href="@Url.Action("Index","WriterHeading")">Başlıklarım</a>
                <a class="btn-ghost" href="@Url.Action("Index","WriterProfile")">&#64;@Model.CurrentWriterName</a>
                using (Html.BeginForm("Logout", "WriterAccount", FormMethod.Post, new { style = "display:inline" }))
                {
                    @Html.AntiForgeryToken()<button type="submit" class="btn-ghost">Çıkış yap</button>
                }
            }
            else if (Request.IsAuthenticated && !User.Identity.Name.StartsWith("writer:", StringComparison.Ordinal))
            {
                <a class="btn-ghost" href="@Url.Action("Index","AdminDashboard")">Yönetim</a>
                using (Html.BeginForm("Logout", "Login", FormMethod.Post, new { style = "display:inline" }))
                {
                    @Html.AntiForgeryToken()<button type="submit" class="btn-ghost">Çıkış yap</button>
                }
            }
            else
            {
                <a class="btn-ghost" href="@Url.Action("Login","WriterAccount")">Giriş Yap</a>
                <a class="btn-accent" href="@Url.Action("Register","WriterAccount")">Kayıt Ol</a>
            }
        </div>
    </nav>
    <div class="sidebar-overlay" id="sidebarOverlay"></div>
    <div id="layout">
        <aside id="sidebar">
            <div class="sidebar-header"><h6>Başlıklar</h6><div class="sidebar-search-wrap"><i class="bi bi-funnel"></i><input id="sidebarSearch" type="search" placeholder="Başlık filtrele…" autocomplete="off" /></div></div>
            <div id="topic-list">
                @foreach (var h in Model.Headings)
                {
                    <button type="button" class="topic-item @(selected == h.HeadingID ? "active" : "")" data-heading-id="@h.HeadingID" data-title="@h.HeadingName">
                        <span class="topic-title">@h.HeadingName</span>
                        <span class="topic-count">@Model.Entries.Count(e => e.HeadingID == h.HeadingID)</span>
                    </button>
                }
                @if (Model.Headings.Count == 0)
                {<div class="empty-state" style="padding:20px">Henüz başlık yok.</div>}
            </div>
        </aside>
        <main id="main">
            @if (TempData["Success"] != null)
            {<div class="szx-notice" role="status">@TempData["Success"]</div>}
            @if (TempData["Error"] != null)
            {<div class="szx-notice error" role="alert">@TempData["Error"]</div>}
            <div class="sx-discover-row">
                <div class="trending-strip" id="trendingStrip" aria-label="Son başlıklar">
                    <span class="chip" style="cursor:default"><i class="bi bi-fire" aria-hidden="true"></i> Son başlıklar:</span>
                    @foreach (var h in Model.Headings.Take(8))
                    {<button type="button" class="chip" data-heading-id="@h.HeadingID">@h.HeadingName</button>}
                </div>
                <nav class="sx-discover-links" aria-label="SözlükX sayfaları">
                    <a href="@Url.Action("About","Home")"><i class="bi bi-info-circle" aria-hidden="true"></i> Hakkımızda</a>
                    <a href="@Url.Action("Contact","Home")"><i class="bi bi-envelope" aria-hidden="true"></i> İletişim</a>
                    <a href="@Url.Action("Index","Gallery")"><i class="bi bi-images" aria-hidden="true"></i> Galeri</a>
                    @if (Model.CurrentWriterID.HasValue)
                    {<a href="@Url.Action("Inbox","WriterMessage")"><i class="bi bi-chat-left-text" aria-hidden="true"></i> Mesajlarım</a>}
                </nav>
            </div>
            <div class="content-header">
                <div>
                    <h1 id="contentTitle">@(selected.HasValue ? Model.Headings.First(x=>x.HeadingID==selected.Value).HeadingName : "Bir başlık seçin")</h1>
                    <span class="entry-count-pill" id="contentCount">— entry</span>
                </div><div class="sx-public-links">
                    @if (Model.CurrentWriterID.HasValue)
                    {<a class="btn-ghost" href="@Url.Action("Create","WriterHeading")"><i class="bi bi-plus"></i> Başlık aç</a>}
                    else
                    {<a class="btn-ghost" href="@Url.Action("Login","WriterAccount")">Başlık açmak için giriş yap</a>}
                    <button class="btn-new-entry" type="button" id="newEntryBtn" disabled="@(selected.HasValue ? (bool?)null : true)"><i class="bi bi-plus-lg"></i> Yeni Entry</button>
                </div>
            </div>
            <div class="sort-bar" id="sortBar"><span>Sırala:</span><button type="button" class="sort-btn active" data-sort="newest">En yeni</button><button type="button" class="sort-btn" data-sort="oldest">En eski</button></div>
            <div id="entries-container">
                @if (Model.Headings.Count == 0)
                {<div class="empty-state"><i class="bi bi-journal-x"></i><h4>Henüz başlık açılmamış</h4><p>Giriş yapan yazarlar bir başlık oluşturabilir.</p></div>}
                @foreach (var h in Model.Headings)
                {
                    <section class="sx-heading-entries" data-heading-section="@h.HeadingID" style="@(selected==h.HeadingID?"":"display:none")">
                        @foreach (var e in Model.Entries.Where(x => x.HeadingID == h.HeadingID))
                        {
                            <article class="entry-card" data-entry-date="@e.ContentDate.Ticks">
                                <div class="entry-text" style="white-space:pre-wrap;overflow-wrap:anywhere">@e.ContentValue</div>
                                <div class="entry-footer">
                                    <div class="entry-meta">
                                        <span class="entry-avatar" style="background:#D4622A">@((e.Writer!=null&&e.Writer.WriterUserName!=null&&e.Writer.WriterUserName.Length>0)?e.Writer.WriterUserName.Substring(0,1).ToUpperInvariant():"?")</span>
                                        <div><div class="entry-author">&#64;@(e.Writer==null?"bilinmeyen":e.Writer.WriterUserName)</div><div class="entry-date">@e.ContentDate.ToString("dd.MM.yyyy HH:mm")</div></div>
                                    </div>
                                    <div class="sx-entry-tools">
                                        @if (Model.CurrentWriterID.HasValue && Model.CurrentWriterID.Value == e.WriterID)
                                        {
                                            <a href="@Url.Action("Edit","Entry",new{id=e.ContentID})">Düzenle</a>
                                            using (Html.BeginForm("Delete", "Entry", new { id = e.ContentID }, FormMethod.Post, new { style = "display:inline" }))
                                            {
                                                @Html.AntiForgeryToken()<button type="submit" class="sx-entry-delete">Sil</button>
                                            }
                                        }
                                    </div>
                                </div>
                            </article>
                        }
                        @if (!Model.Entries.Any(x => x.HeadingID == h.HeadingID))
                        {
                            <div class="empty-state"><i class="bi bi-chat-dots"></i><h4>Henüz entry yok</h4><p>Bu başlığa ilk entry'yi yazabilirsin.</p></div>
                        }
                    </section>
                }
            </div>
        </main>
    </div>
    <div class="modal-backdrop-custom" id="entryModal">
        <div class="modal-box">
            <h5>Yeni Entry — <span id="modalTopicName">Başlık</span></h5>
            @if (Model.CurrentWriterID.HasValue)
            {
                using (Html.BeginForm("Create", "Entry", FormMethod.Post, new { id = "entryForm" }))
                {
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="entryHeadingID" name="HeadingID" value="@(selected.HasValue?selected.Value:0)" />
                    <textarea id="entryTextarea" name="ContentValue" minlength="5" maxlength="5000" required placeholder="Entry'ni buraya yaz…"></textarea>
                    <div id="charCount" class="sx-headcount">0 / 5000 karakter</div>
                    <div class="modal-footer-row"><button type="button" class="btn-ghost" id="cancelModal">İptal</button><button type="submit" class="btn-accent">Kaydet</button></div>
                }
            }
            else
            {
                <p>Entry yazabilmek için yazar hesabınla giriş yapmalısın.</p>
                <div class="modal-footer-row"><button type="button" class="btn-ghost" id="cancelModal">İptal</button><a class="btn-accent" href="@Url.Action("Login","WriterAccount")">Giriş Yap</a></div>
            }
        </div>
    </div>
    <script src="@Url.Content("~/Scripts/sozlukx-live.js")"></script>
</body>
</html>